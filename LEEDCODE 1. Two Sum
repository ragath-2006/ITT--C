import java.util.Arrays;
import java.util.Comparator;

class Solution {
    private static class NumberPair {
        int value;
        int originalIndex;

        NumberPair(int value, int originalIndex) {
            this.value = value;
            this.originalIndex = originalIndex;
        }
    }

    public int[] twoSum(int[] nums, int target) {
        int n = nums.length;
        NumberPair[] pairs = new NumberPair[n];
        for (int i = 0; i < n; i++) {
            pairs[i] = new NumberPair(nums[i], i);
        }
        Arrays.sort(pairs, Comparator.comparingInt(pair -> pair.value));
        int left = 0;
        int right = n - 1;
        while (left < right) {
            int currentSum = pairs[left].value + pairs[right].value;
            if (currentSum == target) {
                return new int[] { pairs[left].originalIndex, pairs[right].originalIndex };
            } 
            else if (currentSum < target) {
                left++;  
            } 
            else {
                right--; 
            }
        }
        return new int[] {};
    }
    public static void main(String[] args) {
        Solution solver = new Solution();
        int[] nums = {2, 7, 11, 15};
        int target = 9;

        int[] result = solver.twoSum(nums, target);
        System.out.println("Indices: [" + result[0] + ", " + result[1] + "]");
    }
}
