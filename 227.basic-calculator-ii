class Solution {
    public int calculate(String s) {
        if (s == null || s.length() == 0) {
            return 0;
        }

        int currentNumber = 0;
        int lastTerm = 0;
        int totalResult = 0;
        char operation = '+'; 
        int len = s.length();

        for (int i = 0; i < len; i++) {
            char currentChar = s.charAt(i);

            if (Character.isDigit(currentChar)) {
                currentNumber = (currentNumber * 10) + (currentChar - '0');
            }

            if (!Character.isDigit(currentChar) && currentChar != ' ' || i == len - 1) {
                if (operation == '+') {
                    totalResult += lastTerm; 
                    lastTerm = currentNumber;
                } else if (operation == '-') {
                    totalResult += lastTerm;
                    lastTerm = -currentNumber;
                } else if (operation == '*') {
                    lastTerm = lastTerm * currentNumber; 
                } else if (operation == '/') {
                    lastTerm = lastTerm / currentNumber; 
                }
                
                operation = currentChar; 
                currentNumber = 0;       
            }
        }

        totalResult += lastTerm;
        return totalResult;
    }
}
