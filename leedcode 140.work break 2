import java.util.*;

public class Solution {
    public List<String> wordBreak(String s, List<String> wordDict) {
        
        Set<String> wordSet = new HashSet<>(wordDict);
        
        Map<String, List<String>> memo = new HashMap<>();
        
        return backtrack(s, wordSet, memo);
    }

    private List<String> backtrack(String s, Set<String> wordSet, Map<String, List<String>> memo) {
        
        if (memo.containsKey(s)) {
            return memo.get(s);
        }

        List<String> results = new ArrayList<>();

      
        if (s.isEmpty()) {
            results.add("");
            return results;
        }

        for (int i = 1; i <= s.length(); i++) {
            String prefix = s.substring(0, i);

            if (wordSet.contains(prefix)) {
                String suffix = s.substring(i);
                List<String> subSegments = backtrack(suffix, wordSet, memo);

             
                for (String segment : subSegments) {
                    if (segment.isEmpty()) {
                        results.add(prefix);
                    } else {
                        results.add(prefix + " " + segment);
                    }
                }
            }
        }

        memo.put(s, results);
        return results;
    }
}
