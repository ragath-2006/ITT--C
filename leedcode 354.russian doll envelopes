import java.util.Arrays;

class Solution {
    public int maxEnvelopes(int[][] envelopes) {
        if (envelopes == null || envelopes.length == 0) {
            return 0;
        }
        
        Arrays.sort(envelopes, (a, b) -> {
            if (a[0] == b[0]) {
                return b[1] - a[1]; 
            } else {
                return a[0] - b[0]; 
            }
        });
        int n = envelopes.length;
        int[] tails = new int[n];
        int len = 0;
        
        for (int[] envelope : envelopes) {
            int height = envelope[1];
            int i = 0, j = len;
            while (i < j) {
                int mid = i + (j - i) / 2;
                if (tails[mid] < height) {
                    i = mid + 1;
                } else {
                    j = mid;
                }
            }
            tails[i] = height;
            
           if (i == len) {
                len++;
            }
        }
        
        return len;
    }
}
